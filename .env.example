# Copy this file to .env.local for local development. Never commit .env.local.

# Your EmpirioLabs AI API key, from https://platform.empiriolabs.ai/dashboard/api-keys
# It stays on the server and is never sent to the browser.
EMPIRIOLABS_API_KEY=

# Optional. The model the chat starts with, by model ID or alias, for example
# qwen3-8-flash. Leave empty to start with the catalog's first featured chat model.
EMPIRIOLABS_MODEL=

# Optional. Set to true for a public demo: each visitor enters their own API key,
# which stays in their browser tab, and EMPIRIOLABS_API_KEY is not used.
DEMO_MODE=false
