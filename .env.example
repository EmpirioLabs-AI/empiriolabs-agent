# Copy this file to .env.local for local development. Never commit .env.local.

# Optional. Without a key, the app runs in sign-in mode: each visitor signs in
# with their EmpirioLabs AI account, and their usage is billed to their account
# (https://docs.empiriolabs.ai/oauth).
# Set it to use one key for every visitor, for a private deployment. Your
# EmpirioLabs AI API key, from https://platform.empiriolabs.ai/dashboard/api-keys
# It stays on the server and is never sent to the browser.
EMPIRIOLABS_API_KEY=

# Optional. The app's public https address, for example https://agent.example.com.
# Sign-in uses it for the app's client ID and return address. Leave it empty to
# use the address each request arrives at.
APP_URL=

# Optional. The model the chat starts with, by model ID or alias, for example
# glm-5-3-flash. Leave empty to start with the catalog's first featured chat model.
EMPIRIOLABS_MODEL=

# Optional. Set to false to turn the EmpirioLabs AI tools off, so the app is a
# plain chat. Tools are on when this is empty.
EMPIRIOLABS_TOOLS=

# Optional. Set to true to use sign-in mode even when EMPIRIOLABS_API_KEY is set.
DEMO_MODE=false
